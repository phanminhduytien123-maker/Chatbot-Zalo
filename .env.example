# ================================================================
# CẤU HÌNH AI ZALO BOT - TRỢ LÝ SINH VIÊN TOÀN NĂNG
# ================================================================

# [1] Cấu hình AI (Google Gemini - Miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# [2] Chế độ kiểm thử (MOCK_MODE=true khi chưa có Cookie hoặc muốn test nhanh)
# Đổi thành false khi muốn kết nối Cổng sinh viên thật
MOCK_MODE=true

# [3] Cấu hình Cổng Sinh Viên Trường (Portal)
PORTAL_URL=https://stdportal.tdtu.edu.vn
STUDENT_ID=52100001
STUDENT_NAME=Nguyễn Văn A

# Cookie phiên đăng nhập (Lấy từ F12 -> Network -> Cookie trên trang trường)
STUDENT_COOKIE=ASP.NET_SessionId=xxxxxxxxxx; .ASPXAUTH=yyyyyyyyyy

# [4] Thời gian quét ngầm tự động (phút)
# Mặc định quét mỗi 3 phút 1 lần
CHECK_INTERVAL_MINUTES=3

# [5] Cấu hình Zalo (Chế độ mô phỏng / Zalo Live)
# ZALO_TARGET_PHONE: Số điện thoại người nhận thông báo
ZALO_TARGET_PHONE=0901234567
